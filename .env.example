# Consumed by docker-compose.yml (Compose auto-loads a file named .env in the
# same directory as docker-compose.yml). Copy to .env and adjust if these
# ports collide with something else already running on your machine.
# This is NOT a Laravel .env — each app still has its own under apps/*/.env.

POSTGRES_DB=loja
POSTGRES_USER=loja
POSTGRES_PASSWORD=loja
POSTGRES_PORT=5432

REDIS_PORT=6379

BACKEND_PORT=8000
ADMIN_PORT=8001
